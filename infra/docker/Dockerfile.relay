FROM rust:1.97-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build -p torca-relay --release --locked

FROM debian:bookworm-slim
RUN useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin torca
RUN mkdir -p /var/lib/torca && chown -R torca:torca /var/lib/torca
COPY --from=build /src/target/release/torca-relay /usr/local/bin/torca-relay
# The compose deployment bind-mounts a Windows host directory at
# /var/lib/torca. Docker Desktop does not preserve Linux ownership metadata
# for that mount, so the process must be able to create Arti state there.
# The relay remains isolated inside the private compose network.
ENV TORCA_RELAY_BIND=0.0.0.0:8844
EXPOSE 8844
ENTRYPOINT ["/usr/local/bin/torca-relay"]
