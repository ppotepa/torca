# syntax=docker/dockerfile:1.7
FROM rust:1.97-bookworm AS build
WORKDIR /src
ARG TORCA_RELAY_BUILD_ID=development
ARG TORCA_RELAY_SOURCE_COMMIT=working-tree
ENV TORCA_RELAY_BUILD_ID=${TORCA_RELAY_BUILD_ID}
ENV TORCA_RELAY_SOURCE_COMMIT=${TORCA_RELAY_SOURCE_COMMIT}
COPY . .
# Keep registry, git and compiler artefacts between image rebuilds. The binary
# is copied out of the cache mount during the same layer because cache mounts
# are intentionally not committed to the final image filesystem.
RUN --mount=type=cache,id=torca-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=torca-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=torca-relay-target,target=/src/target \
    cargo build -p torca-relay --release --locked \
    && mkdir -p /out \
    && cp /src/target/release/torca-relay /out/torca-relay

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends libsqlite3-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin torca
RUN mkdir -p /var/lib/torca && chown -R torca:torca /var/lib/torca
COPY --from=build /out/torca-relay /usr/local/bin/torca-relay
RUN ldd /usr/local/bin/torca-relay
# The compose deployment bind-mounts a Windows host directory at
# /var/lib/torca. Docker Desktop does not preserve Linux ownership metadata
# for that mount, so the process must be able to create Arti state there.
# The relay remains isolated inside the private compose network.
ENV TORCA_RELAY_BIND=0.0.0.0:8844
EXPOSE 8844
ENTRYPOINT ["/usr/local/bin/torca-relay"]
